# ─── LLM Providers ───────────────────────────────────────
LLM_PRIMARY_PROVIDER=deepseek                # deepseek | anthropic | openai

# DeepSeek (current primary)
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Anthropic / OpenAI / Google — optional fallbacks
# GOOGLE_API_KEY also unlocks nano-banana image generation (Gemini 2.5
# Flash Image). Get a free key at https://aistudio.google.com/apikey.
# When set, the slides pipeline will paint AI hero images instead of
# (or before falling back to) Unsplash stock photos. See the
# "Image search & generation" section below for the full chain.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Default routing (model strings sent to whichever provider is primary)
# DeepSeek currently exposes:
#   - deepseek-v4-pro    (quality, ¥3/M in cache-miss, ¥6/M out — discounted thru 2026-05-31)
#   - deepseek-v4-flash  (volume, ¥1/M in cache-miss, ¥2/M out)
#   - deepseek-chat / deepseek-reasoner (LEGACY — deprecating 2026-07-24)
LLM_MODEL_PLANNER=deepseek-v4-pro
LLM_MODEL_WORKER=deepseek-v4-flash
LLM_MODEL_CRITIC=deepseek-v4-pro

# ─── Web Search ──────────────────────────────────────────
TAVILY_API_KEY=

# ─── Image search & generation (hero photos on title/section/closing) ─
#
# Composite chain: nano-banana → Unsplash → noop. The first provider
# that returns a non-nil result wins; nothing crashes if all are unset.
#
# 1) Nano-banana (Gemini 2.5 Flash Image) — text → 16:9 PNG. Set
#    GOOGLE_API_KEY above to enable. ~$0.03 per 1024×1024 image.
#    Generated PNGs land under SLIDE_OUT_DIR/ai-images/ and are served
#    at /api/v1/assets/ai-images/{filename}. Free key at
#    https://aistudio.google.com/apikey.
#
# 2) Unsplash — stock photo fallback. Free dev tier at
#    https://unsplash.com/developers (50 reqs/hour). Set the key
#    below. Leave empty to skip.
#
# With neither set, slides render with no hero image (still functional;
# title/section/closing layouts degrade to text-only).
UNSPLASH_ACCESS_KEY=

# ─── Database & Cache ────────────────────────────────────
# Local dev runs Postgres in docker-compose. Production points at Supabase
# (same Postgres wire protocol, just swap the connection string).
DATABASE_URL=postgres://dreamwaver:dreamwaver@localhost:5432/dreamwaver?sslmode=disable
# Production: postgres://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=redis://localhost:6379/0

# ─── Object Storage ──────────────────────────────────────
S3_ENDPOINT=http://localhost:9000            # MinIO 本地
S3_ACCESS_KEY=dreamwaver
S3_SECRET_KEY=dreamwaver-secret
S3_BUCKET=dreamwaver
S3_REGION=us-east-1

# ─── Auth (Supabase) ─────────────────────────────────────
# Supabase issues JWTs signed with its project JWT secret. The Go
# orchestrator verifies incoming tokens via the JWKS URL below.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json

# ─── Billing (Stripe) ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Service URLs ────────────────────────────────────────
ORCHESTRATOR_HTTP_PORT=8080
ORCHESTRATOR_GRPC_PORT=8081
SANDBOX_GRPC_ADDR=localhost:50051
WEB_PORT=3000

# ─── Misc ────────────────────────────────────────────────
LOG_LEVEL=info
ENV=development
CHROMEDP_HEADLESS=true
